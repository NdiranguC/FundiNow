# Use `supabase status` to get the local URL and API keys after `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Optional: required for Google Maps, Places search, and reverse geocoding.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
